# Clé API Cartesia (https://play.cartesia.ai) — utilisée uniquement par `npm run generate-voices`
CARTESIA_API_KEY=

# Voix japonaises des PNJ selon leur genre (ID copiés depuis https://play.cartesia.ai/voices)
# Hommes : agent de gare, ramen, banque, électronique, jeux vidéo
CARTESIA_VOICE_ID_HOMME=
# Femmes : konbini, téléphonie, figurines, pharmacie
CARTESIA_VOICE_ID_FEMME=
# Optionnel : voix de vos réponses (sinon la voix homme)
CARTESIA_PLAYER_VOICE_ID=

# Optionnel : modèle / version d'API
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2025-04-16
